# Copy to .env (never commit the real file). One set of values per environment.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Cloudflare R2 (server-side only - do NOT prefix with NEXT_PUBLIC_)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Public base URL of this environment's R2 bucket (custom domain or r2.dev), no trailing slash.
# Safe to expose, so it uses NEXT_PUBLIC_. It is read at BUILD time: build staging and
# production with their own value. Leave empty to serve images from /public.
#   staging:    https://staging-assets.daffabadranthoriq.com
#   production: https://assets.daffabadranthoriq.com
NEXT_PUBLIC_ASSETS_BASE_URL=""
