generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Portfolio content: projects and experience.
// Table and column names are snake_case so they read well in DBeaver; the
// Prisma side stays camelCase through @map / @@map.
// ─────────────────────────────────────────────────────────────────────────────

enum ExperienceGroup {
  FULL_TIME     @map("full-time")
  NON_FULL_TIME @map("non-full-time")
}

enum EmploymentType {
  FULL_TIME  @map("Full time")
  INTERNSHIP @map("Internship")
  CONTRACT   @map("Contract")
  PART_TIME  @map("Part time")
  COMMUNITY  @map("Community")
}

/// Skills and tools shown as chips. Shared by projects and experience.
model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(80)

  projects   ProjectTag[]
  experience ExperienceTag[]

  @@map("tags")
}

model Project {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(120)
  title       String   @db.VarChar(200)
  category    String   @db.VarChar(60)
  description String   @db.Text
  liveUrl     String?  @map("live_url") @db.VarChar(500)
  /// Lower numbers are shown first.
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  images ProjectImage[]
  links  ProjectLink[]
  tags   ProjectTag[]

  @@index([sortOrder])
  @@index([category])
  @@map("projects")
}

model ProjectImage {
  id        Int     @id @default(autoincrement())
  projectId Int     @map("project_id")
  /// R2 object key, for example "portfolio-projects/tiket-com/tiket-1.jpg".
  /// The full URL is built per environment from NEXT_PUBLIC_ASSETS_BASE_URL.
  r2Key     String  @map("r2_key") @db.VarChar(500)
  alt       String  @db.VarChar(300)
  caption   String? @db.VarChar(300)
  /// The image with the lowest sort_order is the project's cover.
  sortOrder Int     @default(0) @map("sort_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_images")
}

model ProjectLink {
  id        Int    @id @default(autoincrement())
  projectId Int    @map("project_id")
  /// Button text, for example "Github", "FE" or "BE".
  label     String @db.VarChar(60)
  url       String @db.VarChar(500)
  sortOrder Int    @default(0) @map("sort_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_links")
}

model ProjectTag {
  projectId Int @map("project_id")
  tagId     Int @map("tag_id")
  sortOrder Int @default(0) @map("sort_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
  @@map("project_tags")
}

model Experience {
  id             Int             @id @default(autoincrement())
  slug           String          @unique @db.VarChar(120)
  /// Latest title at the company.
  role           String          @db.VarChar(200)
  company        String          @db.VarChar(200)
  /// First day of the starting month.
  startDate      DateTime        @map("start_date") @db.Date
  /// Empty while the position is still running.
  endDate        DateTime?       @map("end_date") @db.Date
  /// With end_date empty, true means "Present".
  isCurrent      Boolean         @default(false) @map("is_current")
  group          ExperienceGroup
  employmentType EmploymentType  @map("employment_type")
  location       String?         @db.VarChar(200)
  description    String          @db.VarChar(500)
  url            String?         @db.VarChar(500)
  sortOrder      Int             @default(0) @map("sort_order")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  roles      ExperienceRole[]
  highlights ExperienceHighlight[]
  tags       ExperienceTag[]

  @@index([group, startDate])
  @@index([sortOrder])
  @@map("experience")
}

/// One row per title held at a company. Only needed when a company has more than one.
model ExperienceRole {
  id           Int       @id @default(autoincrement())
  experienceId Int       @map("experience_id")
  title        String    @db.VarChar(200)
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  isCurrent    Boolean   @default(false) @map("is_current")
  sortOrder    Int       @default(0) @map("sort_order")

  experience Experience            @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  highlights ExperienceHighlight[]

  @@index([experienceId, sortOrder])
  @@map("experience_roles")
}

/// A bullet point. Attached to a role when the company has several, otherwise
/// to the experience itself (role_id stays empty).
model ExperienceHighlight {
  id           Int    @id @default(autoincrement())
  experienceId Int    @map("experience_id")
  roleId       Int?   @map("role_id")
  text         String @db.Text
  sortOrder    Int    @default(0) @map("sort_order")

  experience Experience      @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  role       ExperienceRole? @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([experienceId, sortOrder])
  @@index([roleId, sortOrder])
  @@map("experience_highlights")
}

model ExperienceTag {
  experienceId Int @map("experience_id")
  tagId        Int @map("tag_id")
  sortOrder    Int @default(0) @map("sort_order")

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([experienceId, tagId])
  @@index([tagId])
  @@map("experience_tags")
}
