# Copy to .env (never commit the real file). One set of values per environment.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Cloudflare R2 (server-side only - do NOT prefix with NEXT_PUBLIC_)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Public base URL of this environment's R2 bucket (custom domain or r2.dev), no trailing slash.
# Safe to expose, so it uses NEXT_PUBLIC_. It is read at BUILD time: build staging and
# production with their own value. Leave empty to serve images from /public.
#   staging:    https://staging-assets.daffabadranthoriq.com
#   production: https://assets.daffabadranthoriq.com
NEXT_PUBLIC_ASSETS_BASE_URL=""

# Public URL of this environment, no trailing slash. Read at BUILD time, so build each
# environment with its own value. Used for canonical URLs, the sitemap and structured data.
# ONLY the production URL is indexed by search engines; any other value (staging, previews)
# is automatically noindex and blocked in robots.txt. Defaults to production when empty,
# so ALWAYS set it on staging.
#   staging:    https://staging.daffabadranthoriq.com
#   production: https://daffabadranthoriq.com
NEXT_PUBLIC_SITE_URL=""

# Optional: Google Search Console "HTML tag" verification token (the content="..." value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
